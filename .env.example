# Application Configuration
APP_NAME=technical-analysis-service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_ENABLED=True
CACHE_TTL=300

# Service Discovery
EUREKA_ENABLED=False
EUREKA_SERVER_URL=http://localhost:8761/eureka

# Observability
METRICS_ENABLED=True
TRACING_ENABLED=True
LOG_LEVEL=INFO

# Database (Postgres)
DATABASE_URL=postgresql://gravity:gravity@localhost:5432/tech_analysis
TSE_DATABASE_URL=postgresql://gravity:gravity@localhost:5432/tech_analysis
ALLOW_DB_FALLBACK=false

# Analysis Configuration
MAX_CANDLES=1000
PARALLEL_PROCESSING=True
MAX_WORKERS=10

# Event Messaging
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@localhost/

# Data Ingestion
ENABLE_DATA_INGESTION=false
INGESTION_AUTH_TOKEN=default_ingestion_token

# Feature Toggles
EXPOSE_DB_EXPLORER=false
ENABLE_SCENARIOS=false
